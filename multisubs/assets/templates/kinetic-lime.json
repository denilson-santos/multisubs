{
  "schema_version": 5,
  "name": "kinetic-lime",
  "description": "Fast kinetic captions with a lime active-word accent for explainers and tutorials.",
  "style": {
    "typography": {
      "font_family": "Montserrat",
      "font_weight": "bold",
      "highlight_color": "#D9F99D"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "5%"
    }
  },
  "animation": {
    "cue": {
      "text": {
        "entrance": {
          "type": "slide-up",
          "duration_ms": 180
        },
        "exit": {
          "type": "fade"
        }
      }
    },
    "word": {
      "text": {
        "emphasis": {
          "type": "highlight"
        }
      }
    }
  }
}
