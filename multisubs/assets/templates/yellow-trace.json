{
  "schema_version": 5,
  "name": "yellow-trace",
  "description": "Progressive yellow word highlighting on a compact panel for tips and step-by-step clips.",
  "style": {
    "typography": {
      "font_family": "Inter",
      "font_weight": "medium",
      "highlight_color": "#FBE003"
    },
    "backdrop": {
      "color": "#111827FF",
      "size": "15%"
    }
  },
  "animation": {
    "word": {
      "text": {
        "mode": "progressive",
        "emphasis": {
          "type": "highlight"
        }
      }
    }
  }
}
