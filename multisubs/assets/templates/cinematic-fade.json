{
  "schema_version": 4,
  "name": "cinematic-fade",
  "description": "Soft serif captions with cue fades for documentary and cinematic scenes; aligned words are not required.",
  "style": {
    "typography": {
      "font_family": "Lora",
      "font_weight": "semi-bold",
      "font_size": "4.2%",
      "italic": true,
      "letter_spacing": "0px",
      "line_height": "auto",
      "text_case": "original",
      "color": "#FFF4E6",
      "highlight_color": null
    },
    "backdrop": {"type": "outline", "color": "#111111D9", "size": "4%"},
    "word_backdrop": {"type": "none", "color": "#111827E6", "size": "12%"},
    "shadow": {"size": "2%"},
    "opacity": "95%"
  },
  "layout": {
    "position": "bottom-center",
    "margins": {"left": "15%", "right": "15%", "top": "0%", "bottom": "3%"},
    "max_width": "100%",
    "max_height": "16%"
  },
  "animation": {
    "cue": {
      "text": {"entrance": {"type": "fade", "duration_ms": 220}, "emphasis": {"type": "none"}, "exit": {"type": "fade", "duration_ms": 180}},
      "backdrop": {"entrance": {"type": "fade", "duration_ms": 220}, "emphasis": {"type": "none"}, "exit": {"type": "fade", "duration_ms": 180}}
    },
    "word": {
      "text": {"mode": "active-word", "entrance": {"type": "none"}, "emphasis": {"type": "none"}, "exit": {"type": "none"}},
      "backdrop": {"mode": "active-word", "entrance": {"type": "none"}, "emphasis": {"type": "none"}, "exit": {"type": "none"}}
    }
  }
}
