{
  "schema_version": 5,
  "name": "neon-magenta-pulse",
  "description": "Neon-magenta active-word pulses for bold reactions, cuts, and creator commentary.",
  "style": {
    "typography": {
      "font_family": "Roboto",
      "font_weight": "bold",
      "text_case": "uppercase",
      "color": "#FF4FD8",
      "font_size": "3.8%"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "5%"
    }
  },
  "animation": {
    "word": {
      "text": {
        "emphasis": {
          "type": "pulse",
          "duration_ms": 400
        }
      }
    }
  },
  "layout": {
    "max_height": "9.4%"
  }
}
