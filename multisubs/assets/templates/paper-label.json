{
  "schema_version": 5,
  "name": "paper-label",
  "description": "Dark editorial labels on a warm paper panel with a restrained slide-in.",
  "style": {
    "typography": {
      "font_family": "Roboto",
      "font_weight": "medium",
      "font_size": "3.2%",
      "color": "#111827"
    },
    "backdrop": {
      "color": "#FFF8EDFF",
      "size": "20%"
    }
  },
  "layout": {
    "position": "top-left",
    "margins": {
      "left": "10%",
      "right": "10%",
      "top": "12%"
    },
    "max_height": "6%"
  },
  "animation": {
    "cue": {
      "text": {
        "entrance": {
          "type": "slide-right",
          "duration_ms": 160
        },
        "exit": {
          "type": "fade"
        }
      },
      "backdrop": {
        "entrance": {
          "type": "slide-right",
          "duration_ms": 160
        },
        "exit": {
          "type": "fade"
        }
      }
    }
  }
}
