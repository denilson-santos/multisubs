{
  "schema_version": 5,
  "name": "neon-cyan-reveal",
  "description": "Progressive cyan word reveals for clean, high-energy short-form explainers.",
  "style": {
    "typography": {
      "font_family": "Atkinson Hyperlegible Next",
      "font_weight": "bold",
      "color": "#00F5FF",
      "font_size": "4.99%"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "5%"
    }
  },
  "animation": {
    "word": {
      "text": {
        "mode": "progressive",
        "entrance": {
          "type": "slide-up",
          "duration_ms": 120
        }
      }
    }
  },
  "layout": {
    "max_height": "11.9%"
  }
}
