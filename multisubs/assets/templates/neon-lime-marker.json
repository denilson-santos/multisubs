{
  "schema_version": 5,
  "name": "neon-lime-marker",
  "description": "Compact neon-lime word markers that track energetic spoken captions.",
  "style": {
    "typography": {
      "font_family": "Oswald",
      "font_weight": "medium",
      "highlight_color": "#111827"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "4%"
    },
    "word_backdrop": {
      "type": "box",
      "color": "#39FF14FF",
      "size": "12%"
    }
  },
  "animation": {
    "word": {
      "text": {
        "emphasis": {
          "type": "highlight"
        }
      },
      "backdrop": {
        "entrance": {
          "type": "zoom",
          "duration_ms": 100
        },
        "exit": {
          "type": "fade",
          "duration_ms": 70
        }
      }
    }
  }
}
