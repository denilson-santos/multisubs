{
  "schema_version": 5,
  "name": "cobalt-pop",
  "description": "Centered cobalt pop-in captions for hooks and strong short-form statements.",
  "style": {
    "typography": {
      "font_family": "Inter",
      "font_weight": "extra-bold",
      "font_size": "3.5%",
      "text_case": "uppercase"
    },
    "backdrop": {
      "color": "#1E40AFFF",
      "size": "18%"
    }
  },
  "layout": {
    "position": "center",
    "margins": {
      "left": "10%",
      "right": "10%"
    },
    "max_width": "90%",
    "max_height": "6%"
  },
  "animation": {
    "cue": {
      "text": {
        "entrance": {
          "type": "pop",
          "duration_ms": 180
        },
        "exit": {
          "type": "zoom",
          "duration_ms": 140
        }
      },
      "backdrop": {
        "entrance": {
          "type": "pop",
          "duration_ms": 180
        },
        "exit": {
          "type": "zoom",
          "duration_ms": 140
        }
      }
    }
  }
}
