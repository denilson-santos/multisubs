{
  "schema_version": 5,
  "name": "headline-bounce",
  "description": "Punchy yellow headlines with a bounded active-word bounce for energetic cuts.",
  "style": {
    "typography": {
      "font_family": "Oswald",
      "font_weight": "semi-bold",
      "text_case": "uppercase",
      "color": "#FDE68A",
      "font_size": "5.06%"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "6%"
    }
  },
  "animation": {
    "cue": {
      "text": {
        "entrance": {
          "type": "fade",
          "duration_ms": 120
        },
        "exit": {
          "type": "slide-down",
          "duration_ms": 160
        }
      }
    },
    "word": {
      "text": {
        "emphasis": {
          "type": "bounce",
          "duration_ms": 420
        }
      }
    }
  },
  "layout": {
    "max_height": "11.3%"
  }
}
