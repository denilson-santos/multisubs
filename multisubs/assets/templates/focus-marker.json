{
  "schema_version": 5,
  "name": "focus-marker",
  "description": "Accessible active-word captions with an amber marker for lessons and explainers.",
  "style": {
    "typography": {
      "font_family": "Atkinson Hyperlegible Next",
      "font_weight": "bold",
      "font_size": "3.4%",
      "highlight_color": "#111827"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "4%"
    },
    "word_backdrop": {
      "type": "box",
      "color": "#FFD54F",
      "size": "12%"
    }
  },
  "layout": {
    "position": "bottom-center",
    "margins": {
      "left": "10%",
      "right": "10%"
    },
    "max_height": "6%"
  },
  "animation": {
    "word": {
      "text": {
        "emphasis": {
          "type": "highlight"
        }
      }
    }
  }
}
