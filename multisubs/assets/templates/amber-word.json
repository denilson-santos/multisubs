{
  "schema_version": 5,
  "name": "amber-word",
  "description": "Legible outlined captions that highlight each spoken word in amber.",
  "style": {
    "typography": {
      "font_family": "Inter",
      "font_weight": "semi-bold",
      "highlight_color": "#FFD54F",
      "font_size": "4.65%"
    },
    "backdrop": {
      "type": "outline",
      "color": "#111827",
      "size": "5%"
    }
  },
  "animation": {
    "word": {
      "text": {
        "emphasis": {
          "type": "highlight"
        }
      }
    }
  },
  "layout": {
    "max_height": "9.7%"
  }
}
