{
  "schema_version": 5,
  "name": "mint-progress",
  "description": "Progressive mint word highlighting for tips, steps, and demonstrations.",
  "style": {
    "typography": {
      "font_family": "Montserrat",
      "font_weight": "medium",
      "highlight_color": "#A7F3D0",
      "font_size": "5.24%"
    },
    "backdrop": {
      "color": "#111827D9",
      "size": "15%"
    }
  },
  "animation": {
    "word": {
      "text": {
        "mode": "progressive",
        "emphasis": {
          "type": "highlight"
        }
      }
    }
  },
  "layout": {
    "max_height": "11.3%"
  }
}
